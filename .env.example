# ==============================================================================
# Xion-Pay Environment Configuration
# ==============================================================================

# Entorno de ejecución (development | staging | production)
ENVIRONMENT=development
APP_PORT=8000
SECRET_KEY=super-secret-crypto-hash-key-xion-pay-2026-prod-ready
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=8

# Claves Asimétricas para Firma Criptográfica de Licencias (RS256)
RSA_PRIVATE_KEY_PATH=./certs/license_private.pem
RSA_PUBLIC_KEY_PATH=./certs/license_public.pem

# Base de Datos (SQLite para desarrollo local o PostgreSQL / Supabase)
# ==============================================================================
# Para desarrollo local rápido sin Postgres:
DATABASE_URL=sqlite+aiosqlite:///./xionpay.db

# Para Supabase PostgreSQL (Recomendado en Producción / Cloud):
# Opción A (Recomendada - Connection Pooler IPv4 en puerto 6543, Transaction Mode):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Opción B (Connection Pooler en puerto 5432, Session Mode):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Opción C (Direct Connection - Requiere red con soporte IPv6):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Google OAuth 2.0 (Google Identity Services)
# ==============================================================================
# Obtén tu Client ID en https://console.cloud.google.com/apis/credentials
# En "Authorized JavaScript origins" agrega: http://localhost:5173 y la URL de tu despliegue (ej. https://xion-pay.onrender.com)
GOOGLE_CLIENT_ID=mock-google-client-id-for-dev.apps.googleusercontent.com

# Administrador inicial aprovisionado automáticamente al iniciar la base de datos
# (Asigna aquí tu cuenta de Google/Gmail para tener acceso como superadmin de inmediato)
INITIAL_ADMIN_EMAIL=admin@xionpay.internal

# CORS & WebSockets
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://admin.xionpay.com
