# ==============================================================================
# Xion-Pay Environment Configuration
# ==============================================================================

# Entorno de ejecución (development | staging | production)
ENVIRONMENT=development
APP_PORT=8000
SECRET_KEY=super-secret-crypto-hash-key-xion-pay-2026-prod-ready
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=8

# Claves Asimétricas para Firma Criptográfica de Licencias (RS256)
RSA_PRIVATE_KEY_PATH=./certs/license_private.pem
RSA_PUBLIC_KEY_PATH=./certs/license_public.pem

# Base de Datos PostgreSQL
POSTGRES_USER=xionpay_admin
POSTGRES_PASSWORD=strong_vault_password_2026
POSTGRES_DB=xionpay_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Nota: Para desarrollo local rápido sin Postgres activo, se puede usar:
# DATABASE_URL=sqlite+aiosqlite:///./xionpay.db
DATABASE_URL=sqlite+aiosqlite:///./xionpay.db

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=mock-google-client-id-for-dev.apps.googleusercontent.com

# CORS & WebSockets
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://admin.xionpay.com
